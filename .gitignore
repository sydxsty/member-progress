# Only source, documentation and selected assets belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/app/

/app/*
!/app/*.cs
!/app/*.csproj
!/app/app.ico
!/app/app.manifest
!/app/Assistant/
!/app/web/
!/app/runtime/

/app/Assistant/*
!/app/Assistant/*.cs
!/app/Assistant/README.md

/app/web/*
!/app/web/*.js
!/app/web/*.css
!/app/web/*.html
!/app/web/logo.png

/app/runtime/*
!/app/runtime/codex/
/app/runtime/codex/*
!/app/runtime/codex/bundled.json

/docs/*
!/docs/usage.md
!/docs/design.md
!/docs/images/
/docs/images/*
!/docs/images/members.png
!/docs/images/projects.png

# Always exclude user records, credentials and generated output.
**/[Dd]ata/
**/bin/
**/obj/
**/.vs/
**/.env
**/.env.*
**/secret*.dat
**/auth.json
**/*.pfx
**/*.pem
**/*.key
**/*.user
**/*.suo
