# Only source, documentation and selected assets belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/app/
!/mobile/
!/scripts/
!/wechat-reader/

/app/*
!/app/*.cs
!/app/*.csproj
!/app/app.ico
!/app/app.manifest
!/app/Assistant/
!/app/web/
!/app/runtime/
!/app/Remote/
!/app/WeChat/

/app/WeChat/*
!/app/WeChat/*.cs
!/app/WeChat/README.md

/app/Assistant/*
!/app/Assistant/*.cs
!/app/Assistant/README.md

/app/web/*
!/app/web/*.js
!/app/web/*.css
!/app/web/*.html
!/app/web/logo.png
!/app/web/mobile/
/app/web/mobile/*.apk

/app/runtime/*
!/app/runtime/codex/
!/app/runtime/frp/
!/app/runtime/wechat-reader/
/app/runtime/wechat-reader/*
!/app/runtime/wechat-reader/bundled.json
!/app/runtime/embedding/
/app/runtime/embedding/*
!/app/runtime/embedding/bundled.json
/app/runtime/frp/*
!/app/runtime/frp/bundled.json
/app/runtime/codex/*
!/app/runtime/codex/bundled.json

/docs/*
!/docs/usage.md
!/docs/design.md
!/docs/mobile.md
!/docs/wechat.md
!/docs/images/
/docs/images/*
!/docs/images/members.png
!/docs/images/projects.png
!/docs/images/mobile-members.png
!/docs/images/mobile-gantt.png

# Always exclude user records, credentials and generated output.
**/[Dd]ata/
**/bin/
**/obj/
**/build/
**/.gradle/
**/local.properties
**/*.jks
**/*.keystore
**/.vs/
**/.env
**/.env.*
**/secret*.dat
**/auth.json
**/*.pfx
**/*.pem
**/*.key
**/*.user
**/*.suo
